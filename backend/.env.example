# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=sqlite:///db.sqlite3

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Health API
HEALTH_CHECK_PASSWORD=change-me

# API Rate Limiting
RATELIMIT_ANON=60/minute
RATELIMIT_USER=300/minute
RATELIMIT_AUTH=10/minute
RATELIMIT_SENSITIVE=30/minute
RATELIMIT_HEALTH=120/minute
RATELIMIT_LOCATION=30/minute
DRIVER_MATCH_RADIUS_KM=3.0
DRIVER_DESTINATION_TTL_MINUTES=120
DRIVER_MAX_ACTIVE_TRIPS=1
# Leave empty locally (in-memory cache); use Redis in staging/production
RATELIMIT_CACHE_URL=

# Celery
CELERY_ENABLED=False
CELERY_BEAT_ENABLED=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_WORKER_CONCURRENCY=2

# Business settings
REQUEST_TTL_MINUTES=30
DRIVER_LOCATION_STALE_SECONDS=120

# Deployment
DOMAIN=example.com
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_PATH=/opt/tariqi/backend
FRONTEND_PATH=/opt/tariqi/frontend
MEDIA_PATH=/opt/tariqi/backend/media
STATIC_PATH=/opt/tariqi/backend/static
SYSTEMD_SERVICE_NAME=tariqi-backend

# Staging/production Docker (Postgres)
POSTGRES_USER=tariqi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tariqi
NGINX_PORT=80

# OTP login
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_BACKEND=apps.accounts.sms.ConsoleSMSBackend
REQUEST_REMINDER_MINUTES=5
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@example.com
DRIVER_VERIFICATION_REQUIRED=True
